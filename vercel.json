{
  "version": 2,
  "builds": [
    {
      "src": "server.js",
      "use": "@vercel/node"
    },
    {
      "src": "index.html",
      "use": "@vercel/static"
    },
    {
      "src": "math.html",
      "use": "@vercel/static"
    },
    {
      "src": "core.js",
      "use": "@vercel/static"
    },
    {
      "src": "app.js",
      "use": "@vercel/static"
    },
    {
      "src": "advanced.js",
      "use": "@vercel/static"
    }
  ],
  "routes": [
    {
      "src": "/api/analyze",
      "dest": "/server.js"
    },
    {
      "src": "/",
      "dest": "/index.html"
    },
    {
      "src": "/(index.html|math.html|core.js|app.js|advanced.js)",
      "dest": "/$1"
    },
    {
      "src": "/.*",
      "status": 404
    }
  ]
}